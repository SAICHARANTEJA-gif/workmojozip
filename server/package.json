{
  "name": "workmojo-server",
  "version": "1.0.0",
  "description": "Production Node.js + Express API Backend for WORK MOJO",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/ml', {recursive:true}); fs.copyFileSync('ml/model_random_forest.json', 'dist/ml/model_random_forest.json'); fs.mkdirSync('dist/src/ml', {recursive:true}); fs.copyFileSync('ml/model_random_forest.json', 'dist/src/ml/model_random_forest.json');\"",
    "postinstall": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "typescript": "^5.8.2",
    "ws": "^8.21.3",
    "@types/ws": "^8.18.1"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
