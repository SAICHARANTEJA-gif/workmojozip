# Backend Environment Variables (Render / Host)
PORT=5000

# Google Gemini API Key (Primary Production AI Provider)
# Set this in your Render Dashboard -> Environment Variables
GEMINI_API_KEY=

# Optional: Gemini Model override (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: Supabase PostgreSQL credentials if connecting to live cloud database
SUPABASE_URL=
SUPABASE_ANON_KEY=

