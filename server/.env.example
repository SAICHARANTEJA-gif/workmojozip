# Backend Environment Variables (Render / Host)
PORT=5000

# Google Gemini API Key (Primary Production AI Provider)
# Set this in your Render Dashboard -> Environment Variables
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Supabase PostgreSQL credentials (Set in Render Dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Production SMS Providers (Configure one provider for OTP delivery)
# Option A: Twilio (Global Standard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option B: Fast2SMS (Indian SMS Gateway for +91 numbers)
FAST2SMS_API_KEY=
